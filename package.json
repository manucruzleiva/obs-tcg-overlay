{
  "name": "obs-tcg-overlay",
  "version": "1.2.0",
  "description": "OTO (OBS TCG Overlay): streaming overlay and producer control panel for Pokémon TCG matches",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"tests/server/*.test.js\"",
    "test:ui": "node --test \"tests/ui/*.test.js\"",
    "update:decks": "node scripts/update-popular-decks.js",
    "pack:example": "node scripts/pack-example.js",
    "tauri:stage": "node scripts/stage-tauri.js",
    "desktop:dev": "npm run tauri:stage && npx --yes @tauri-apps/cli@2.12.6 dev",
    "desktop:build": "npm run tauri:stage && npx --yes @tauri-apps/cli@2.12.6 build"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "socket.io": "^4.7.2",
    "sql.js": "^1.17.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "socket.io-client": "^4.7.2"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "obs",
    "overlay",
    "streaming",
    "pokemon",
    "pokemon-tcg",
    "tcg",
    "tauri",
    "socket.io"
  ],
  "author": "obs-tcg-overlay contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manucruzleiva/obs-tcg-overlay.git"
  },
  "bugs": {
    "url": "https://github.com/manucruzleiva/obs-tcg-overlay/issues"
  },
  "homepage": "https://github.com/manucruzleiva/obs-tcg-overlay#readme"
}
